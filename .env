# ===========================
# PostgreSQL
# ===========================
POSTGRES_USER=claimassist
POSTGRES_PASSWORD=claimassist

# ===========================
# Redis
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================
# Kafka
# ===========================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===========================
# Eureka
# ===========================
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ===========================
# Config Server
# ===========================
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_GIT_URI=file:///D:/Mayur/1/Deployment/insurance-ai-platform/local-config-repo
CONFIG_GIT_LABEL=main
SPRING_PROFILES_ACTIVE=local

# ===========================
# Zipkin
# ===========================
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ===========================
# Keycloak
# ===========================
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=claimassist

KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/claimassist
KEYCLOAK_JWKS_URI=http://localhost:8180/realms/claimassist/protocol/openid-connect/certs

# Public client
KEYCLOAK_TOKEN_CLIENT_ID=claimassist-customer-app
KEYCLOAK_TOKEN_CLIENT_SECRET=

# Confidential client (service account)
KEYCLOAK_ADMIN_CLIENT_ID=claimassist-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=local-dev-admin-client-secret
SERVICE_CLIENT_ID=claimassist-admin-service
SERVICE_CLIENT_SECRET=local-dev-admin-client-secret

# ===========================
# Internal Service Calls
# ===========================
INTERNAL_API_SECRET=local-dev-internal-secret

# ===========================
# AI
# ===========================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AI_API_KEY=${OPENAI_API_KEY}