# Enforce LF and normalize text files
* text=auto eol=lf

# Binary files - do not attempt to normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Shell scripts should be executable on checkout on unix systems
scripts/*.sh text eol=lf

# Ensure Git handles Windows and Unix line endings for batch and scripts
*.cmd text eol=crlf
*.ps1 text eol=crlf

