# ===========================
# PostgreSQL
# ===========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=claimassist
POSTGRES_PASSWORD=changeme

# ===========================
# Redis
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================
# Kafka
# ===========================
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ===========================
# Eureka
# ===========================
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ===========================
# Config Server
# ===========================
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_GIT_URI=file:./config-repo
CONFIG_GIT_LABEL=master
SPRING_PROFILES_ACTIVE=local

# ===========================
# Zipkin
# ===========================
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ===========================
# Keycloak
# ===========================
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=claimassist
SERVICE_TOKEN_URI=http://localhost:8180/realms/claimassist/protocol/openid-connect/token

KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/claimassist
KEYCLOAK_JWKS_URI=http://localhost:8180/realms/claimassist/protocol/openid-connect/certs

# Public client
KEYCLOAK_TOKEN_CLIENT_ID=claimassist-customer-app
KEYCLOAK_TOKEN_CLIENT_SECRET=

# Confidential client (service account)
KEYCLOAK_ADMIN_CLIENT_ID=claimassist-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme
SERVICE_CLIENT_ID=claimassist-admin-service
SERVICE_CLIENT_SECRET=changeme

# ===========================
# Internal Service Calls
# ===========================
INTERNAL_API_SECRET=changeme

# ===========================
# Outbox Configuration
# ===========================
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_INITIAL_DELAY_MS=2000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_RETRY_MULTIPLIER=2.0
OUTBOX_TOPIC_PARTITIONS=3
OUTBOX_TOPIC_REPLICATION_FACTOR=1
OUTBOX_TOPIC_MIN_IN_SYNC_REPLICAS=1

# ===========================
# Saga Orchestrator Configuration
# ===========================
SAGA_TIMEOUT_SECONDS=180
SAGA_TIMEOUT_SCAN_MS=5000
SAGA_RECOVERY_RETRY_DELAY_SECONDS=30
SAGA_RECOVERY_SCAN_MS=15000
SAGA_RECOVERY_MAX_ATTEMPTS=3

# ===========================
# AI
# ===========================
OPENAI_API_KEY=changeme
AI_API_KEY=changeme

# ===========================
# Docker Registry (for K8s)
# ===========================
REGISTRY=localhost:5000

# ===========================
# Grafana
# ===========================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
