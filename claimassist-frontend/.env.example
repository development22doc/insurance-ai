# API Configuration
# The base URL for the ClaimAssist API Gateway
# Examples:
# - Local development: http://localhost:8080
# - K3s local-k8s: http://<DEV-HOST>:30080  # replace with your DEV NodePort host (do not commit real IPs)
# - Production: https://api.claimassist.example.com
VITE_API_BASE_URL=http://localhost:8080

# OAuth Configuration
# The frontend URL for OAuth callback (must match Keycloak redirect URIs)
# Examples:
# - Local development: http://localhost:3000
# - K3s local-k8s: http://<DEV-HOST>:30080  # replace with your DEV NodePort host (do not commit real IPs)
# - Production: https://app.claimassist.example.com
VITE_FRONTEND_URL=http://localhost:3000
