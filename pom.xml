<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.claimassist.platform</groupId>
    <artifactId>claimassist-ai-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>ClaimAssist AI Platform</name>
    <description>
        Insurance AI agent platform - identical tech stack and hardening
        patterns to the distributed Lovable-clone project, re-pointed at a
        real insurance business problem. See INSURANCE_AI_PLATFORM.md.
    </description>

    <modules>
        <module>common-lib</module>
        <module>discovery-service</module>
        <module>config-service</module>
        <module>api-gateway</module>
        <module>customer-service</module>
        <module>claims-service</module>
        <module>agent-service</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Common versions for child modules -->
        <lombok.version>1.18.28</lombok.version>
        <testcontainers.version>1.20.0</testcontainers.version>

        <!--
            JaCoCo XML report paths consumed by SonarScanner for Maven. Per the
            SonarQube Cloud docs, the Maven scanner reads analysis properties from
            pom.xml (not sonar-project.properties), so this is defined here as the
            single source of truth. Paths are root-relative per-module reports
            emitted into target/site/jacoco/ during the Maven verify phase.
            Modules with zero test classes (discovery-service, config-service,
            api-gateway) have no JaCoCo execution data and emit NO report; Sonar
            tolerates a missing file and simply reports no coverage for them while
            continuing to analyze every module. Nothing is fabricated.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>common-lib/target/site/jacoco/jacoco.xml,discovery-service/target/site/jacoco/jacoco.xml,config-service/target/site/jacoco/jacoco.xml,api-gateway/target/site/jacoco/jacoco.xml,customer-service/target/site/jacoco/jacoco.xml,claims-service/target/site/jacoco/jacoco.xml,agent-service/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    OWASP dependency-check. Version and config are centrally managed here (pluginManagement)
                    so the Security workflow can invoke the plugin deterministically via full GA
                    coordinates: mvn org.owasp:dependency-check-maven:12.2.2:check. Coordinates are
                    org.owasp:dependency-check-maven (the previously used
                    org.owasp.dependency-check-maven-plugin:dependency-check-maven-plugin does not exist on
                    Maven Central). NOT bound to any lifecycle phase: only the Security workflow invokes it.
                    failBuildOnCVSS=8 fails the build on any High+ vulnerability; failOnError=true fails if
                    the scan itself errors.
                -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>12.2.2</version>
                    <configuration>
                        <failBuildOnCVSS>8</failBuildOnCVSS>
                        <failOnError>true</failOnError>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
                Declared here (not pluginManagement) so child modules inherit and actually
                execute these lifecycle-bound goals. Maven's default lifecycle never invokes
                JaCoCo's prepare-agent/report, so leaving it only in pluginManagement would
                silently drop coverage; it must be an active inherited plugin.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
