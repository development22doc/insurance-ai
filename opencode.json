{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5-coder:3b",
  "shell": "pwsh",
  "provider": {
    "ollama": {
      "models": {
        "qwen3:4b": {
          "name": "Qwen3 4B"
        },
        "qwen2.5-coder:3b": {
          "name": "Qwen2.5 Coder 3B"
        },
        "deepseek-coder:1.3b": {
          "name": "DeepSeek Coder 1.3B"
        }
      }
    }
  },
  "mcp": {
    "sonarqube": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--init",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "-e",
        "SONARQUBE_TOOLSETS=issues,quality-gates,coverage,projects",
        "-e",
        "SONARQUBE_READ_ONLY=true",
        "sonarsource/sonarqube-mcp"
      ],
      "environment": {
        "SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "{env:SONARQUBE_ORG}"
      }
    }
  }
}