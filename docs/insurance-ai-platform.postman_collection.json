            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"John\", \"lastName\": \"Doe\", \"email\": \"john@example.com\", \"password\": \"SecurePassword123!\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/customers/register",
              "host": ["{{base_url}}"],
              "path": ["api", "customers", "register"]
            }
